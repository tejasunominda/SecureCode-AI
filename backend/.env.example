# SecureCode AI Platform - Environment Variables
# Copy this file to .env and fill in the values

# JWT secret (base64-encoded HMAC-SHA256 key, minimum 32 bytes)
# Generate with: openssl rand -base64 32
SECURECODE_JWT_SECRET=change-me-please-iam-a-super-secret-key-for-jwt-hmac-sha-256-bits

# Database
POSTGRES_USER=securecode
POSTGRES_PASSWORD=securecode

# Frontend API URLs (point to API gateway in production)
VITE_API_BASE_URL=http://localhost:8080
VITE_ASSESSMENT_API_BASE_URL=http://localhost:8080

# Distributed tracing (Jaeger OTLP endpoint)
OTLP_ENDPOINT=http://localhost:4318/v1/traces

# Rate limiting (requests per minute per IP)
SECURECODE_RATELIMIT_AUTH_MAX=100
SECURECODE_RATELIMIT_API_MAX=200

# API Gateway service URLs (for production override)
IDENTITY_SERVICE_URL=http://identity-service:8081
ASSESSMENT_SERVICE_URL=http://assessment-service:8082
EXECUTION_SERVICE_URL=http://execution-service:8083
PROCTORING_SERVICE_URL=http://proctoring-service:8084
REPORTING_SERVICE_URL=http://reporting-service:8085
NOTIFICATION_SERVICE_URL=http://notification-service:8086

# SSO/SAML (FR-AUTH-02,03) — leave blank to disable
SSO_GOOGLE_CLIENT_ID=
SSO_GOOGLE_CLIENT_SECRET=
SSO_GOOGLE_REDIRECT_URI=http://localhost:5175/login?provider=google
SSO_AZURE_CLIENT_ID=
SSO_AZURE_CLIENT_SECRET=
SSO_AZURE_REDIRECT_URI=http://localhost:5175/login?provider=azure
SSO_AZURE_TENANT_ID=common

# Proctoring alert thresholds (FR-MON-04)
PROCTORING_ALERT_WARNING=30
PROCTORING_ALERT_CRITICAL=60
PROCTORING_ALERT_TERMINATION=80
